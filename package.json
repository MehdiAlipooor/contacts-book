{
  "name": "contact-phone",
  "private": true,
  "type": "commonjs",
  "bin": {
    "contact": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "cli": "ts-node -r tsconfig-paths/register ./src/app.ts",
    "cli:prod": "npm run build && node -r module-alias/register ./dist/app.js",
    "format": "npx biome check --write"
  },
  "_moduleAliases": {
    "@": "dist",
    "@utils": "dist/utils",
    "@cli": "dist/cli",
    "@lib": "dist/lib",
    "@repositories": "dist/repositories",
    "@constants": "dist/constants",
    "@types": "dist/types",
    "@ui": "dist/ui"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "inquirer": "^13.1.0",
    "nodemon": "^3.1.11",
    "ora": "^9.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.33",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jest": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "jest-watch-typeahead": "^3.0.1",
    "module-alias": "^2.3.4",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
